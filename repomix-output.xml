  // [Rollback 추가] 기존 게임 코트 삭제
  const handleDeleteCourt = async (courtId: string) => {
    const targetCourt = courts.find(c => c.id === courtId);
    if (!targetCourt) return;

    // 1. 게임 코트인 경우에만 최소 2개 유지 조건 검사
    if (targetCourt.type === 'game') {
